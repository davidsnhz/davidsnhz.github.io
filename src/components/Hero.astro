---
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import PhoneFrame from './PhoneFrame.astro';
import { site } from '../config/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Capturas para el abanico: [centro, izquierda, derecha] */
  phones: [ImageMetadata, ImageMetadata, ImageMetadata];
}

const { lang, phones } = Astro.props;
const [center, left, right] = phones;
const t = useTranslations(lang);
---

<!--
  Tres piezas: título, abanico de teléfonos y texto con botones.
  En el móvil van en ese orden, para que los teléfonos se vean en la primera pantalla;
  en tablet el abanico baja al final y en escritorio ocupa la columna derecha.
-->
<section class="mx-auto grid max-w-6xl items-center gap-x-10 px-5 pt-10 pb-14 sm:px-8 sm:pt-12 sm:pb-16 lg:grid-cols-[1.3fr_1fr] lg:pt-20 lg:pb-20">
  <div class="lg:col-start-1 lg:row-start-1 lg:self-end">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="font-display text-xl font-bold tracking-tight">{site.name}</span>
      <span class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-xs text-muted max-[379px]:px-2.5 max-[379px]:text-[0.6875rem]">
        <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        {t('hero.role')}
      </span>
    </p>

    <h1 class="mt-6 text-[clamp(2.4rem,5vw,3.5rem)] leading-[1.04] tracking-[-0.04em] text-balance">
      {t('hero.title.a')} <span class="block text-muted">{t('hero.title.b')}</span>
    </h1>
  </div>

  <div class="order-3 sm:order-2 lg:col-start-1 lg:row-start-2 lg:self-start">
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{t('hero.text')}</p>

    <!-- En el móvil: "Ver proyectos" a todo el ancho y debajo GitHub y Contacto a medias -->
    <div class="mt-8 grid grid-cols-2 gap-3 sm:mt-9 sm:flex sm:flex-wrap sm:items-center">
      <a
        href={`#${t('id.projects')}`}
        class="col-span-2 inline-flex items-center justify-center gap-2 rounded-full bg-accent px-5 py-3 font-semibold text-black transition-transform duration-300 hover:-translate-y-0.5 sm:justify-start"
      >
        {t('hero.cta.projects')}
        <Icon name="arrow-down" class="size-4" />
      </a>
      <a
        href={site.github}
        class="inline-flex items-center justify-center gap-2 rounded-full border border-line px-5 py-3 font-medium transition-colors hover:border-accent sm:justify-start"
      >
        <Icon name="github" class="size-4" />
        GitHub
      </a>
      <a
        href={`#${t('id.contact')}`}
        class="group inline-flex items-center justify-center gap-2 px-3 py-3 font-medium text-muted transition-colors hover:text-fg max-sm:rounded-full max-sm:border max-sm:border-line max-sm:px-5"
      >
        {t('hero.cta.contact')}
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>

  <!-- Decorativo: las mismas capturas aparecen con su alt en las tarjetas de proyecto -->
  <!-- En el móvil ocupa todo el ancho de la pantalla (hasta 460px, centrado) y se funde por abajo -->
  <div
    class="fan relative order-2 ms-[calc(50%_-_min(50%_+_1.25rem,_230px))] mt-8 aspect-[1/0.8] w-[min(100%_+_2.5rem,_460px)] sm:order-3 sm:mx-auto sm:mt-14 sm:aspect-[1/0.98] sm:w-full sm:max-w-[460px] lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0"
    aria-hidden="true"
  >
    <PhoneFrame src={left} alt="" sizes="(min-width: 1024px) 180px, 37vw" loading="eager" class="fan__phone fan__phone--left" />
    <PhoneFrame src={right} alt="" sizes="(min-width: 1024px) 180px, 37vw" loading="eager" class="fan__phone fan__phone--right" />
    <PhoneFrame src={center} alt="" sizes="(min-width: 1024px) 210px, 44vw" loading="eager" class="fan__phone fan__phone--center" />
  </div>
</section>

<style>
  .fan {
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* En el móvil el abanico es más bajo: los teléfonos se cortan con un degradado hacia el fondo.
     Va de borde a borde, así que se recorta para que las esquinas inclinadas no hagan scroll horizontal
     (y, en un navegador sin máscaras, para que los teléfonos no tapen el texto de debajo) */
  @media (width < 40rem) {
    .fan {
      overflow: clip;
      -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent 98%);
      mask-image: linear-gradient(to bottom, #000 58%, transparent 98%);
    }
  }

  /* Los tres teléfonos parten del centro y se abren en abanico al cargar */
  .fan :global(.fan__phone) {
    position: absolute;
    top: 9%;
    left: 50%;
    width: 37%;
    transform: translateX(calc(-50% + var(--x))) rotate(var(--r));
    transition: transform 0.6s var(--ease);
    animation: fan-in 1s var(--ease) 0.15s backwards;
  }

  .fan :global(.fan__phone--center) {
    top: 0;
    z-index: 1;
    width: 44%;
    --x: 0%;
    --r: 0deg;
    animation-delay: 0s;
  }

  .fan :global(.fan__phone--left) {
    --x: -78%;
    --r: -9deg;
  }

  .fan :global(.fan__phone--right) {
    --x: 78%;
    --r: 9deg;
  }

  @media (hover: hover) {
    .fan:hover :global(.fan__phone--left) {
      --x: -86%;
      --r: -12deg;
    }

    .fan:hover :global(.fan__phone--right) {
      --x: 86%;
      --r: 12deg;
    }

    .fan:hover :global(.fan__phone--center) {
      transform: translateX(-50%) translateY(-0.5rem);
    }
  }

  @keyframes fan-in {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(1.5rem) rotate(0deg);
    }
  }
</style>
