---
interface Props {
  eyebrow: string;
  title: string;
  /** id del h2, para aria-labelledby de la sección */
  id: string;
  intro?: string;
}

const { eyebrow, title, id, intro } = Astro.props;
---

<div data-reveal class="mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-4 border-t border-line pt-8 sm:mb-14">
  <div>
    <p class="text-xs font-semibold tracking-[0.18em] text-accent-text uppercase">{eyebrow}</p>
    <h2 id={id} class="mt-3 max-w-2xl text-3xl leading-tight sm:text-5xl">{title}</h2>
  </div>
  {intro && <p class="max-w-sm text-muted">{intro}</p>}
</div>
