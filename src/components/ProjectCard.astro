---
import Icon from './Icon.astro';
import PhoneFrame from './PhoneFrame.astro';
import { projectPath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { slugOf, type Project } from '../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
  /** Tarjeta a todo el ancho, con el texto y el teléfono en dos columnas */
  featured?: boolean;
}

const { project, lang, featured = false } = Astro.props;
const { title, description, stack, demo, repo, cover } = project.data;
const t = useTranslations(lang);
const href = projectPath(slugOf(project), lang);

const phoneClass = featured ? '-mb-28 w-[240px] sm:w-[260px]' : '-mb-24 w-[200px] sm:w-[210px]';
---

<article
  data-reveal
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-[2rem] border border-line bg-surface transition-colors duration-300 hover:border-accent',
    featured && 'md:col-span-2 md:grid md:grid-cols-2',
  ]}
>
  <div class:list={['flex flex-col p-7 sm:p-10', featured && 'md:p-12']}>
    <span
      class="absolute top-6 right-6 grid size-10 place-items-center rounded-full border border-line text-muted transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-black sm:top-8 sm:right-8"
      aria-hidden="true"
    >
      <Icon name="arrow-up-right" class="size-4" />
    </span>

    {featured && <span class="mb-5 w-fit rounded-full bg-accent/15 px-2.5 py-1 text-xs font-semibold text-accent-text">{t('projects.featured')}</span>}

    <h3 class:list={['pr-12', featured ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl']}>
      <!-- El enlace del título cubre toda la tarjeta; los botones quedan por encima -->
      <a href={href} class="rounded-md after:absolute after:inset-0 after:content-['']">{title}</a>
    </h3>
    <p class="mt-3 max-w-md text-muted sm:text-lg">{description}</p>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label={t('projects.stack')}>
      {stack.map((tech) => <li class="rounded-full border border-line px-2.5 py-1 text-xs text-muted">{tech}</li>)}
    </ul>

    <div class:list={['relative z-10 mt-7 flex flex-wrap gap-3', featured && 'md:mt-auto md:pt-10']}>
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-full bg-fg px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-85"
          >
            {t('projects.demo')}
            <Icon name="arrow-up-right" class="size-4" />
            <span class="sr-only">
              {title} ({t('projects.newTab')})
            </span>
          </a>
        )
      }
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium transition-colors hover:border-accent"
          >
            <Icon name="github" class="size-4" />
            {t('projects.code')}
            <span class="sr-only">
              {title} ({t('projects.newTab')})
            </span>
          </a>
        )
      }
    </div>
  </div>

  {
    cover && (
      <div class:list={['mt-auto flex justify-center px-8', featured ? 'pt-2 md:pt-14' : 'pt-2']}>
        <PhoneFrame
          src={cover.src}
          alt={cover.alt}
          sizes={featured ? '260px' : '210px'}
          class={`${phoneClass} transition-transform duration-500 group-hover:-translate-y-3`}
        />
      </div>
    )
  }
</article>
