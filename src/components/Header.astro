---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../config/site';
import { homePath, useTranslations } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Esta misma página en el otro idioma */
  altHref: string;
  /** Esta página en su idioma (por defecto, la URL actual) */
  currentHref?: string;
}

const { lang, altHref, currentHref = Astro.url.pathname } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);

const links = [
  { href: `${home}#${t('id.projects')}`, label: t('nav.projects') },
  { href: `${home}#${t('id.about')}`, label: t('nav.about') },
  { href: `${home}#${t('id.contact')}`, label: t('nav.contact') },
];

// Selector ES | EN: el idioma actual apunta a esta página y el otro a su traducción
const langOptions = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  name: languages[code],
  href: code === lang ? currentHref : altHref,
  current: code === lang,
}));
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href={home} class="flex items-center gap-2.5 rounded-lg font-display font-bold" aria-label={t('nav.home')}>
      <span class="grid size-8 place-items-center rounded-lg bg-fg text-[13px] tracking-tight text-bg" aria-hidden="true">{site.initials}</span>
      <span class="hidden tracking-tight min-[400px]:inline" aria-hidden="true">{site.name}</span>
    </a>

    <nav aria-label={t('nav.label')} class="flex items-center gap-2 text-sm">
      <ul class="hidden items-center md:flex">
        {
          links.map((link) => (
            <li>
              <a class="rounded-full px-3 py-2 text-muted transition-colors hover:text-fg" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center rounded-full border border-line p-1 text-xs font-semibold" role="group" aria-label={t('nav.language')}>
        {
          langOptions.map((option) => (
            <a
              href={option.href}
              hreflang={option.code}
              lang={option.code}
              aria-label={option.name}
              aria-current={option.current ? 'page' : undefined}
              class:list={[
                'grid h-8 min-w-9 place-items-center rounded-full px-2.5 uppercase transition-colors',
                option.current ? 'bg-fg text-bg' : 'text-muted hover:text-accent-text',
              ]}
            >
              {option.code}
            </a>
          ))
        }
      </div>
      <ThemeToggle label={t('theme.toggle')} />
    </nav>
  </div>
</header>
