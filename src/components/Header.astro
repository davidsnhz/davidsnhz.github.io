---
import ThemeToggle from './ThemeToggle.astro';
import { homePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Esta misma página en el otro idioma */
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const links = [
  { href: `${home}#${t('id.projects')}`, label: t('nav.projects') },
  { href: `${home}#${t('id.about')}`, label: t('nav.about') },
  { href: `${home}#${t('id.contact')}`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href={home} class="flex items-center gap-2.5 rounded-lg font-display font-bold" aria-label={t('nav.home')}>
      <span class="grid size-8 place-items-center rounded-lg bg-fg text-sm text-bg" aria-hidden="true">D</span>
      <span class="tracking-tight" aria-hidden="true">David</span>
    </a>

    <nav aria-label={t('nav.label')} class="flex items-center gap-2 text-sm">
      <ul class="hidden items-center sm:flex">
        {
          links.map((link) => (
            <li>
              <a class="rounded-full px-3 py-2 text-muted transition-colors hover:text-fg" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={altHref}
        hreflang={other}
        lang={other}
        aria-label={t('nav.switchLang')}
        title={t('nav.switchLang')}
        class="grid h-10 min-w-10 place-items-center rounded-full border border-line px-3 text-xs font-semibold uppercase transition-colors hover:border-accent hover:text-accent-text"
      >
        {other}
      </a>
      <ThemeToggle label={t('theme.toggle')} />
    </nav>
  </div>
</header>
