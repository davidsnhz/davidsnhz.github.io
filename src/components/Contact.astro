---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../config/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const channels = [
  site.email && { icon: 'mail', label: t('contact.email'), value: site.email, href: `mailto:${site.email}` },
  { icon: 'github', label: t('contact.github'), value: site.github.replace('https://', ''), href: site.github },
  site.linkedin && { icon: 'linkedin', label: t('contact.linkedin'), value: site.linkedin.replace(/^https:\/\/(www\.)?/, ''), href: site.linkedin },
].filter(Boolean) as { icon: 'mail' | 'github' | 'linkedin'; label: string; value: string; href: string }[];
---

<section id={t('id.contact')} aria-labelledby="contact-title" class="mx-auto max-w-6xl scroll-mt-20 px-5 pb-24 sm:px-8 lg:pb-32">
  <SectionHeading id="contact-title" eyebrow={t('contact.eyebrow')} title={t('contact.title')} />

  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <p data-reveal class="text-lg text-muted lg:col-span-5">{t('contact.text')}</p>

    <ul data-reveal class="divide-y divide-line border-y border-line lg:col-span-7">
      {
        channels.map((c) => (
          <li>
            <a href={c.href} class="group flex items-center justify-between gap-4 py-5 sm:py-6">
              <span class="flex min-w-0 items-center gap-4">
                <Icon name={c.icon} class="size-5 shrink-0 text-muted transition-colors group-hover:text-accent-text" />
                <span class="min-w-0">
                  <span class="block text-xs font-semibold tracking-[0.18em] text-muted uppercase">{c.label}</span>
                  <span class="block truncate font-display text-xl font-bold transition-colors group-hover:text-accent-text sm:text-2xl">
                    {c.value}
                  </span>
                </span>
              </span>
              <Icon
                name="arrow-up-right"
                class="size-5 shrink-0 text-muted transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent-text"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
