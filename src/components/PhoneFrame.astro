---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Atributo sizes de la imagen; ajústalo al ancho real del marco en cada sitio */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, alt, sizes = '(min-width: 768px) 300px, 70vw', loading = 'lazy', class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <div class="phone__body">
    <div class="phone__screen">
      <Image src={src} alt={alt} widths={[320, 480, 640, src.width]} sizes={sizes} loading={loading} class="phone__img" />
      <span class="phone__island" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  /* Todo en cqw para que el marco escale igual a cualquier tamaño.
     El ancho lo pone quien lo usa (clases de Tailwind); aquí no se fija para no pisarlas */
  .phone {
    container-type: inline-size;
  }

  .phone__body {
    padding: 3.4cqw;
    border-radius: 15cqw;
    background: #0d0d0d;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 0 0 1px #2b2b2b,
      0 2.5rem 4rem -1.5rem rgb(0 0 0 / 0.55);
  }

  .phone__screen {
    position: relative;
    overflow: hidden;
    border-radius: 11.6cqw;
    background: #000;
  }

  .phone__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Dynamic Island, a la altura de la barra de estado de las capturas */
  .phone__island {
    position: absolute;
    top: 2.6cqw;
    left: 50%;
    width: 29cqw;
    height: 8.4cqw;
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
  }
</style>
