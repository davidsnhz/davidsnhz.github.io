---
// La home completa; la usan /index.astro (es) y /en/index.astro (en)
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { live, wip } = await getProjects(lang);
const [featured, ...others] = live;

const covers = live.map((p) => p.data.cover!.src);
const phones = [covers[0], covers[1], covers[2]] as [ImageMetadata, ImageMetadata, ImageMetadata];

const alternates = [
  { lang: 'es', href: '/' },
  { lang: 'en', href: '/en/' },
  { lang: 'x-default', href: '/' },
];
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
  image={`/og-${lang}.png`}
  alternates={alternates}
  skipLabel={t('skip')}
>
  <Header lang={lang} altHref={lang === 'es' ? '/en/' : '/'} />

  <main id="main">
    <Hero lang={lang} phones={phones} />

    <section id={t('id.projects')} aria-labelledby="projects-title" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-12 sm:px-8 lg:py-16">
      <SectionHeading id="projects-title" eyebrow={t('projects.eyebrow')} title={t('projects.title')} intro={t('projects.intro')} />

      <!-- En el móvil, fila que se desliza de lado (con la siguiente tarjeta asomando); desde tablet, rejilla de dos columnas -->
      <div
        data-rail
        class="no-scrollbar -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto overscroll-x-contain px-5 sm:-mx-8 sm:scroll-px-8 sm:px-8 md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0"
      >
        <ProjectCard project={featured} lang={lang} featured />
        {others.map((project) => <ProjectCard project={project} lang={lang} />)}

        {
          wip.map((project) => (
            <article
              data-reveal
              class="rail-item flex flex-wrap items-center justify-between gap-4 rounded-[2rem] border border-dashed border-line px-7 py-6 sm:px-10 md:col-span-2"
            >
              <div>
                <h3 class="text-xl sm:text-2xl">{project.data.title}</h3>
                <p class="mt-1 text-muted">{project.data.description}</p>
              </div>
              <span class="rounded-full border border-accent px-3 py-1 text-xs font-semibold text-accent-text">{t('projects.wip')}</span>
            </article>
          ))
        }
      </div>

      <!-- Indicador del carrusel (solo móvil): puntos y "1 / 7"; decorativo, el lector de pantalla recorre la lista entera -->
      <div class="mt-6 flex items-center justify-between gap-4 md:hidden" aria-hidden="true">
        <div class="flex items-center gap-1.5" data-rail-dots>
          {
            [...live, ...wip].map((_, i) => (
              <span class:list={['h-1.5 rounded-full transition-all duration-300', i === 0 ? 'w-6 bg-accent' : 'w-1.5 bg-line']} />
            ))
          }
        </div>
        <p class="text-sm text-muted tabular-nums">
          <span data-rail-count>1</span> / {live.length + wip.length}
        </p>
      </div>
    </section>

    <About lang={lang} />
    <Contact lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  // Marca en el indicador qué tarjeta del carrusel se está viendo
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-rail-dots] > span')];
  const count = document.querySelector('[data-rail-count]');

  if (rail && count && rail.children.length > 1) {
    const items = [...rail.children] as HTMLElement[];
    let current = 0;
    let frame = 0;

    const update = () => {
      frame = 0;
      const step = items[1].offsetLeft - items[0].offsetLeft;
      const atEnd = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 4;
      const index = atEnd ? items.length - 1 : Math.round(rail.scrollLeft / step);
      if (index === current) return;
      current = index;
      count.textContent = String(index + 1);
      dots.forEach((dot, i) => {
        dot.classList.toggle('w-6', i === index);
        dot.classList.toggle('bg-accent', i === index);
        dot.classList.toggle('w-1.5', i !== index);
        dot.classList.toggle('bg-line', i !== index);
      });
    };

    rail.addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
  }
</script>
