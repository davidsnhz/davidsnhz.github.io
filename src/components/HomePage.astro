---
// La home completa; la usan /index.astro (es) y /en/index.astro (en)
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { live, wip } = await getProjects(lang);
const [featured, ...others] = live;

const covers = live.map((p) => p.data.cover!.src);
const phones = [covers[0], covers[1], covers[2]] as [ImageMetadata, ImageMetadata, ImageMetadata];

const alternates = [
  { lang: 'es', href: '/' },
  { lang: 'en', href: '/en/' },
  { lang: 'x-default', href: '/' },
];
---

<BaseLayout title={t('meta.title')} description={t('meta.description')} lang={lang} alternates={alternates} skipLabel={t('skip')}>
  <Header lang={lang} altHref={lang === 'es' ? '/en/' : '/'} />

  <main id="main">
    <Hero lang={lang} phones={phones} />

    <section id={t('id.projects')} aria-labelledby="projects-title" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-12 sm:px-8 lg:py-16">
      <SectionHeading id="projects-title" eyebrow={t('projects.eyebrow')} title={t('projects.title')} intro={t('projects.intro')} />

      <div class="grid gap-5 md:grid-cols-2">
        <ProjectCard project={featured} lang={lang} featured />
        {others.map((project) => <ProjectCard project={project} lang={lang} />)}

        {
          wip.map((project) => (
            <article
              data-reveal
              class="flex flex-wrap items-center justify-between gap-4 rounded-[2rem] border border-dashed border-line px-7 py-6 sm:px-10 md:col-span-2"
            >
              <div>
                <h3 class="text-xl sm:text-2xl">{project.data.title}</h3>
                <p class="mt-1 text-muted">{project.data.description}</p>
              </div>
              <span class="rounded-full border border-accent px-3 py-1 text-xs font-semibold text-accent-text">{t('projects.wip')}</span>
            </article>
          ))
        }
      </div>
    </section>

    <About lang={lang} />
    <Contact lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
